{
    "printWidth": 120,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "endOfLine": "auto",
    "plugins": ["prettier-plugin-astro"],
    "overrides": [
        { "files": "*.astro", "options": { "parser": "astro" } },
        { "files": ["*.md", "*.mdx", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } }
    ]
}
