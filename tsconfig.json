{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "paths": {
            "#components/*": ["./src/components/*"],
            "#layouts/*": ["./src/layouts/*"],
            "#scripts/*": ["./src/scripts/*"],
            "#styles/*": ["./src/styles/*"],
            "#data/*": ["./src/data/*"],
            "#lib/*": ["./src/lib/*"],
            "#assets/*": ["./src/assets/*"]
        }
    }
}
