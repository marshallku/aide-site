---
// AIDE's mark (the shield and the nib) in currentColor.
import mark from "#assets/aide/mark.svg?raw";

interface Props {
    size?: number;
    class?: string;
}

const { size = 24, class: className } = Astro.props;
const svg = mark
    .replace(/<title>.*?<\/title>/s, "")
    .replace("<svg ", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
---

<span class:list={["mark", className]} set:html={svg} />

<style>
    .mark {
        display: inline-flex;
    }
</style>
