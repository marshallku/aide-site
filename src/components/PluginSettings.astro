---
// A plugin's settings as the app shows them, from its manifest in src/data/plugins.json, in the
// page's language. A setting whose manifest gives its default shows that one (a prompt folds away);
// `defaults` gives every other setting's default as the page describes it ("" for none). A setting
// the manifest has and neither does fails the build, so a new setting in AIDE can't go undocumented.
import { findPlugin, toLocale, type Plugin } from "#lib/plugins";

interface Props {
    id: string;
    kind?: Plugin["kind"];
    defaults: Record<string, string>;
}

const { id, kind = "server", defaults } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const plugin = findPlugin(id, kind, locale);

const missing = plugin.settings
    .filter((field) => !(field.key in defaults) && field.default === undefined)
    .map((field) => field.key);
const extra = Object.keys(defaults).filter((key) => !plugin.settings.some((field) => field.key === key));
if (missing.length > 0 || extra.length > 0) {
    throw new Error(
        `${Astro.url.pathname}: ${id}'s settings table is out of date (no default for: ${missing.join(", ") || "-"}; ` +
            `not in the manifest: ${extra.join(", ") || "-"})`,
    );
}

const LABELS = {
    en: {
        setting: "Setting",
        type: "Type",
        default: "Default",
        about: "What it does",
        none: "—",
        prefilled: "Prefilled in your language",
        types: {
            string: "Text",
            text: "Long text",
            number: "Number",
            bool: "On/off",
            enum: "Choice",
            time: "Time",
            list: "List",
            secret: "Secret",
        },
    },
    ko: {
        setting: "설정",
        type: "종류",
        default: "기본값",
        about: "설명",
        none: "—",
        prefilled: "내 언어로 채워져 있어요",
        types: {
            string: "텍스트",
            text: "긴 텍스트",
            number: "숫자",
            bool: "켜기/끄기",
            enum: "선택",
            time: "시간",
            list: "목록",
            secret: "비밀 값",
        },
    },
}[locale];

const typeLabel = (type: string) => LABELS.types[type as keyof typeof LABELS.types] ?? type;
---

{plugin.settings.length > 0 && (
    <table class="plugin-settings">
        <thead>
            <tr>
                <th>{LABELS.setting}</th>
                <th>{LABELS.type}</th>
                <th>{LABELS.default}</th>
                <th>{LABELS.about}</th>
            </tr>
        </thead>
        <tbody>
            {plugin.settings.map((field) => (
                <tr>
                    <td>
                        <strong>{field.title}</strong>
                        <br />
                        <code>{field.key}</code>
                    </td>
                    <td>
                        <span class:list={["type", { secret: field.type === "secret" }]}>{typeLabel(field.type)}</span>
                    </td>
                    <td>
                        {field.default !== undefined && !(field.key in defaults) ? (
                            field.default.length > 40 || field.default.includes("\n") ? (
                                <details class="prefilled">
                                    <summary>{LABELS.prefilled}</summary>
                                    <pre>{field.default}</pre>
                                </details>
                            ) : (
                                field.default
                            )
                        ) : (
                            defaults[field.key] || LABELS.none
                        )}
                    </td>
                    <td>
                        {field.help}
                        {field.options && (
                            <ul class="options">
                                {field.options.map((option) => (
                                    <li>{option || LABELS.none}</li>
                                ))}
                            </ul>
                        )}
                        {field.link && (
                            <p class="link">
                                <a href={field.link.url} rel="noopener">
                                    {field.link.title} ↗
                                </a>
                            </p>
                        )}
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
)}

<style>
    .plugin-settings td:first-child {
        white-space: nowrap;
    }
    .type {
        font-size: var(--sl-text-xs);
        padding: 0.1em 0.5em;
        border-radius: 999px;
        background: var(--sl-color-gray-6);
        white-space: nowrap;
    }
    .type.secret {
        background: var(--sl-color-accent-low);
        color: var(--sl-color-text-accent);
    }
    .options {
        margin: 0.25rem 0 0;
        padding-inline-start: 1.1rem;
        font-size: var(--sl-text-xs);
    }
    .link {
        margin: 0.25rem 0 0;
    }
    .prefilled summary {
        cursor: pointer;
        font-size: var(--sl-text-xs);
    }
    .prefilled pre {
        max-width: 22rem;
        max-height: 16rem;
        overflow: auto;
        font-size: var(--sl-text-2xs);
        white-space: pre-wrap;
    }
</style>
