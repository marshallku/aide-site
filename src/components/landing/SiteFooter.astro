---
import Mark from "#components/Mark.astro";
import source from "#data/source.json";
import { COPY, RELEASES, docsHref, type Lang } from "#lib/landing-copy";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = COPY[lang].footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="wrap grid">
        <div class="about">
            <p class="brand">
                <Mark size={20} /> AIDE
            </p>
            <p>{copy.tagline}</p>
            <p class="version">
                {copy.version} {source.release.replace(/^v/, "")}
            </p>
        </div>
        <div>
            <p class="heading">{copy.product}</p>
            <ul>
                <li>
                    <a href={docsHref(lang, "getting-started/introduction")}>{copy.links.intro}</a>
                </li>
                <li>
                    <a href={docsHref(lang, "getting-started/install")}>{copy.links.install}</a>
                </li>
                <li>
                    <a href={RELEASES}>{copy.links.releases}</a>
                </li>
                <li>
                    <a href={lang === "ko" ? "/ko/plugins/" : "/plugins/"}>{copy.links.community}</a>
                </li>
                <li>
                    <a href={lang === "ko" ? "/ko/privacy/" : "/privacy/"}>{copy.links.policy}</a>
                </li>
            </ul>
        </div>
        <div>
            <p class="heading">{copy.manual}</p>
            <ul>
                <li>
                    <a href={docsHref(lang, "plugins/overview")}>{copy.links.plugins}</a>
                </li>
                <li>
                    <a href={docsHref(lang, "self-hosting/desktop-host")}>{copy.links.selfHost}</a>
                </li>
                <li>
                    <a href={docsHref(lang, "developers/aidectl")}>{copy.links.developers}</a>
                </li>
                <li>
                    <a href={docsHref(lang, "self-hosting/privacy")}>{copy.links.privacy}</a>
                </li>
            </ul>
        </div>
        <div>
            <p class="heading">{copy.language}</p>
            <ul>
                <li>
                    <a href="/" hreflang="en" lang="en" aria-current={lang === "en" ? "page" : undefined}>
                        English
                    </a>
                </li>
                <li>
                    <a href="/ko/" hreflang="ko" lang="ko" aria-current={lang === "ko" ? "page" : undefined}>
                        한국어
                    </a>
                </li>
            </ul>
        </div>
    </div>
    <div class="wrap legal">© {year} Marshall Ku</div>
</footer>

<style>
    .site-footer {
        margin-top: var(--section-gap);
        padding: 3.5rem 0 2.5rem;
        border-top: 1px solid var(--line);
        font-size: 0.9rem;
        color: var(--ink-2);
    }
    .grid {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 2rem;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 0.5rem;
        color: var(--ink);
        font-weight: 700;
    }
    .about p {
        margin: 0 0 0.35rem;
    }
    .version {
        color: var(--ink-3);
        font-size: 0.8rem;
    }
    .heading {
        margin: 0 0 0.75rem;
        color: var(--ink);
        font-weight: 600;
    }
    ul {
        display: grid;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    a {
        text-decoration: none;
    }
    a:hover,
    a[aria-current="page"] {
        color: var(--ink);
    }
    .legal {
        margin-top: 3rem;
        color: var(--ink-3);
        font-size: 0.8rem;
    }
    @media (max-width: 720px) {
        .grid {
            grid-template-columns: 1fr 1fr;
        }
        .about {
            grid-column: 1 / -1;
        }
    }
</style>
