---
import DayTimeline from "#components/landing/DayTimeline.astro";
import { COPY, type Lang } from "#lib/landing-copy";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = COPY[lang].day;
---

<section class="day-section">
    <div class="wrap">
        <div class="head" data-reveal>
            <p class="eyebrow">{copy.eyebrow}</p>
            <h2 class="display">{copy.title}</h2>
            <p class="lede">{copy.body}</p>
        </div>
        <div data-reveal style="--delay: 0.1s">
            <DayTimeline lang={lang} />
        </div>
    </div>
</section>

<style>
    .day-section {
        margin-top: var(--section-gap);
    }
    .head {
        max-width: 44rem;
        margin-bottom: 3rem;
    }
</style>
