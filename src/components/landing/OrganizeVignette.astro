---
// Organize: scratch notes get a proposed home in the wiki, are checked, and Apply files them.
import Icon from "#components/Icon.astro";
import { COPY, type Lang } from "#lib/landing-copy";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = COPY[lang].capture;
const scratch = lang === "ko" ? "스크래치" : "Scratch";
---

<div class="surface organize" data-play aria-hidden="true">
    <div class="surface-bar">
        <Icon name="scratch" size={15} />
        <span>{scratch}</span>
        <span class="buttons">
            <span class="chip propose">{copy.propose}</span>
            <span class="chip apply">{copy.apply}</span>
        </span>
    </div>
    <ul>
        {copy.scratch.map((note, index) => (
            <li style={`--i: ${index}`}>
                <span class="check" />
                <div class="note">
                    <p class="text">{note.text}</p>
                    <p class="home">
                        <span class="arrow">→</span>
                        <span class="path">{note.home}</span>
                        <span class="chip kind">{note.kind}</span>
                    </p>
                </div>
            </li>
        ))}
    </ul>
</div>

<style>
    .organize {
        padding-bottom: 0.5rem;
    }
    .buttons {
        display: flex;
        gap: 0.4rem;
        margin-left: auto;
    }
    .propose {
        background: var(--fill);
        color: var(--text);
    }
    .apply {
        background: var(--fill);
        color: var(--text-tertiary);
    }
    ul {
        margin: 0;
        padding: 0.5rem 0;
        list-style: none;
    }
    li {
        display: grid;
        grid-template-columns: 1.25rem 1fr;
        gap: 0.75rem;
        align-items: start;
        padding: 0.85rem 1.25rem;
    }
    li + li {
        border-top: 1px solid var(--separator);
    }
    .check {
        position: relative;
        width: 16px;
        height: 16px;
        margin-top: 0.2rem;
        border: 1.5px solid var(--text-tertiary);
        border-radius: 50%;
    }
    .text {
        margin: 0;
        font-family: var(--font-mono);
        font-size: 13px;
    }
    .home {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin: 0.4rem 0 0;
        color: var(--text-secondary);
        font-size: 12.5px;
        opacity: 0;
        transform: translateX(-6px);
    }
    .arrow {
        color: var(--accent);
    }
    .path {
        font-family: var(--font-mono);
        color: var(--text);
    }
    .kind {
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 500;
    }

    .is-playing .propose {
        animation: press 9s infinite;
    }
    .is-playing .home {
        animation: propose 9s var(--ease-out) infinite;
        animation-delay: calc(var(--i) * 0.25s);
    }
    .is-playing .check {
        animation: check 9s infinite;
        animation-delay: calc(var(--i) * 0.3s);
    }
    .is-playing .apply {
        animation: apply 9s infinite;
    }
    .is-playing li {
        animation: file 9s var(--ease-out) infinite;
        animation-delay: calc(var(--i) * 0.12s);
    }
    @keyframes press {
        8% {
            background: var(--accent);
            color: var(--on-accent);
        }
        14%,
        100% {
            background: var(--fill);
            color: var(--text);
        }
    }
    @keyframes propose {
        0%,
        14% {
            opacity: 0;
            transform: translateX(-6px);
        }
        22%,
        82% {
            opacity: 1;
            transform: none;
        }
        100% {
            opacity: 1;
        }
    }
    @keyframes check {
        0%,
        34% {
            border-color: var(--text-tertiary);
            background: transparent;
            box-shadow: none;
        }
        40%,
        84% {
            border-color: var(--accent);
            background: var(--accent);
            box-shadow: inset 0 0 0 3px var(--card);
        }
        100% {
            border-color: var(--text-tertiary);
        }
    }
    @keyframes apply {
        0%,
        52% {
            background: var(--fill);
            color: var(--text-tertiary);
        }
        56%,
        70% {
            background: var(--accent);
            color: var(--on-accent);
        }
        76%,
        100% {
            background: var(--fill);
            color: var(--text-tertiary);
        }
    }
    @keyframes file {
        0%,
        70% {
            opacity: 1;
            transform: none;
        }
        80% {
            opacity: 0;
            transform: translateX(24px);
        }
        90% {
            opacity: 0;
            transform: translateX(-12px);
        }
        100% {
            opacity: 1;
            transform: none;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .home {
            opacity: 1;
            transform: none;
        }
    }
</style>
