---
// A day with the server plugins: what each writes, and when, along a line from morning to night.
import { COPY, type Lang } from "#lib/landing-copy";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const moments = COPY[lang].day.moments;
---

<ol class="day" data-play aria-label={COPY[lang].day.eyebrow}>
    {moments.map((moment, index) => (
        <li style={`--i: ${index}`}>
            <span class="time">{moment.time}</span>
            <span class="node" aria-hidden="true" />
            <div class="card">
                <p class="title">{moment.title}</p>
                <p class="text">{moment.text}</p>
            </div>
        </li>
    ))}
</ol>

<style>
    .day {
        --count: 6;
        position: relative;
        display: grid;
        grid-template-columns: repeat(var(--count), minmax(0, 1fr));
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .day::before,
    .day::after {
        content: "";
        position: absolute;
        top: 2.35rem;
        left: 0;
        right: 0;
        height: 2px;
        border-radius: 2px;
    }
    .day::before {
        background: var(--line-strong);
    }
    .day::after {
        background: linear-gradient(90deg, #ffb340, #ff6b6b 35%, var(--brand-2) 70%, #1e1b4b);
        transform-origin: left;
        transform: scaleX(0);
    }
    .is-playing.day::after {
        animation: sweep 12s linear infinite;
    }
    li {
        display: grid;
        grid-template-rows: auto auto 1fr;
        gap: 0.6rem;
        min-width: 0;
    }
    .time {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--ink-2);
    }
    .node {
        position: relative;
        z-index: 1;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--page);
        box-shadow: inset 0 0 0 2px var(--line-strong);
    }
    .is-playing .node {
        animation: light 12s infinite;
        animation-delay: calc(var(--i) * 2s);
    }
    .card {
        padding: 1rem;
        border-radius: 16px;
        background: var(--page-raised);
        box-shadow: 0 0 0 1px var(--line);
        transition: box-shadow 0.4s;
    }
    .is-playing .card {
        animation: lift 12s infinite;
        animation-delay: calc(var(--i) * 2s);
    }
    .title {
        margin: 0 0 0.35rem;
        font-weight: 650;
    }
    .text {
        margin: 0;
        color: var(--ink-2);
        font-size: 0.9rem;
        line-height: 1.5;
    }
    @keyframes sweep {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }
    @keyframes light {
        0%,
        100% {
            background: var(--page);
            box-shadow: inset 0 0 0 2px var(--line-strong);
        }
        4%,
        14% {
            background: var(--brand-2);
            box-shadow:
                inset 0 0 0 2px var(--brand-2),
                0 0 0 6px color-mix(in srgb, var(--brand-2) 22%, transparent);
        }
        24% {
            background: var(--page);
            box-shadow: inset 0 0 0 2px var(--brand-2);
        }
    }
    @keyframes lift {
        0%,
        100% {
            box-shadow: 0 0 0 1px var(--line);
        }
        4%,
        14% {
            box-shadow:
                0 0 0 1px color-mix(in srgb, var(--brand-2) 55%, transparent),
                0 14px 30px -14px var(--glow);
        }
        24% {
            box-shadow: 0 0 0 1px var(--line);
        }
    }
    @media (max-width: 960px) {
        .day {
            grid-template-columns: 1fr;
            gap: 0.85rem;
            padding-left: 1.5rem;
        }
        .day::before,
        .day::after {
            top: 0;
            bottom: 0;
            left: 0.3rem;
            right: auto;
            width: 2px;
            height: auto;
        }
        .day::after {
            transform-origin: top;
            transform: scaleY(0);
            background: linear-gradient(180deg, #ffb340, #ff6b6b 35%, var(--brand-2) 70%, #1e1b4b);
        }
        @keyframes sweep {
            from {
                transform: scaleY(0);
            }
            to {
                transform: scaleY(1);
            }
        }
        li {
            grid-template-columns: 4.5rem 1fr;
            grid-template-rows: auto;
            align-items: start;
        }
        .node {
            position: absolute;
            left: -1.45rem;
            margin-top: 0.35rem;
        }
        li {
            position: relative;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .day::after {
            transform: none;
        }
    }
</style>
