---
// Every plugin the manual documents, in the page's language, from their manifests.
import Icon from "#components/Icon.astro";
import { COPY, PLUGIN_BLURBS, docsHref, type Lang } from "#lib/landing-copy";
import { devicePluginIds, findPlugin, serverPluginIds } from "#lib/plugins";

interface Props {
    lang: Lang;
}

const ICONS: Record<string, string> = {
    "todo-carry": "todos",
    gcal: "calendar",
    "docs-sync": "folder",
    briefing: "today",
    recap: "review",
    loops: "organize",
    benefits: "inbox",
    recall: "graph",
    gmail: "inbox",
    catchup: "terminal",
    slack: "people",
    radar: "feed",
    eisenhower: "grid",
    excalidraw: "scribble",
    pomodoro: "timer",
    "word-count": "text-size",
};

const { lang } = Astro.props;
const copy = COPY[lang].plugins;
const groups = [
    { title: copy.server, kind: "server" as const, ids: serverPluginIds() },
    { title: copy.device, kind: "device" as const, ids: devicePluginIds() },
].map((group) => ({
    ...group,
    plugins: group.ids.map((id) => findPlugin(id, group.kind, lang)),
}));
---

<section class="plugins" id="plugins">
    <div class="wrap">
        <div class="head" data-reveal>
            <p class="eyebrow">{copy.eyebrow}</p>
            <h2 class="display">{copy.title}</h2>
            <p class="lede">{copy.body}</p>
        </div>
        {groups.map((group) => (
            <div class="group">
                <h3 data-reveal>{group.title}</h3>
                <ul>
                    {group.plugins.map((plugin, index) => (
                        <li data-reveal style={`--delay: ${(index % 4) * 0.05}s`}>
                            <a href={docsHref(lang, `plugins/${plugin.id}`)}>
                                <span class="badge">
                                    <Icon name={ICONS[plugin.id] ?? "plugin"} size={18} />
                                </span>
                                <span class="name">{plugin.name}</span>
                                <span class="about">{PLUGIN_BLURBS[lang][plugin.id] ?? plugin.description}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        ))}
        <p class="more" data-reveal>
            <a href={docsHref(lang, "plugins/overview")}>{copy.more} →</a>
        </p>
    </div>
</section>

<style>
    .plugins {
        margin-top: var(--section-gap);
        scroll-margin-top: 5rem;
    }
    .head {
        max-width: 44rem;
    }
    .group {
        margin-top: 3rem;
    }
    h3 {
        margin: 0 0 1rem;
        color: var(--ink-2);
        font-size: 0.95rem;
        font-weight: 600;
    }
    ul {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
        gap: 0.85rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    a {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: auto 1fr;
        column-gap: 0.75rem;
        row-gap: 0.3rem;
        height: 100%;
        padding: 1rem 1.1rem;
        border-radius: 16px;
        background: var(--page-raised);
        box-shadow: 0 0 0 1px var(--line);
        text-decoration: none;
        transition:
            box-shadow 0.25s,
            transform 0.25s var(--ease-out);
    }
    a:hover {
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--brand-2) 45%, transparent),
            0 12px 30px -16px var(--glow);
        transform: translateY(-2px);
    }
    .badge {
        grid-row: span 2;
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 10px;
        background: linear-gradient(140deg, var(--brand-1), var(--brand-2));
        color: #fff;
    }
    .name {
        align-self: center;
        font-weight: 650;
    }
    .about {
        display: -webkit-box;
        overflow: hidden;
        color: var(--ink-2);
        font-size: 0.875rem;
        line-height: 1.5;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }
    .more {
        margin: 2rem 0 0;
    }
    .more a {
        display: inline;
        padding: 0;
        background: none;
        box-shadow: none;
        color: var(--accent);
        font-weight: 600;
    }
    .more a:hover {
        transform: none;
        box-shadow: none;
    }
</style>
