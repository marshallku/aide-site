---
// The editor: a note being written, with the [[ link picker open over it.
import { COPY, type Lang } from "#lib/landing-copy";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const note = COPY[lang].write.note;
---

<div class="surface editor" data-play aria-hidden="true">
    <div class="surface-bar">
        <span class="lights">
            <i></i>
            <i></i>
            <i></i>
        </span>
        <span class="tab">{note.title}</span>
        <span class="tab muted">topics/launch-checklist</span>
    </div>
    <div class="doc">
        <p class="props">
            <span>status</span> <span class="chip status">draft</span> <span>tags</span>{" "}
            <span class="chip tag">#launch</span>
        </p>
        <h3>{note.title}</h3>
        <p>
            {note.lines[0]}
            <span class="typed">topics/launch</span>
            <span class="caret"></span>
        </p>
        <div class="picker">
            {note.suggestion.map((item, index) => (
                <div class:list={["option", { first: index === 0 }]}>
                    <span class="path">{item}</span>
                </div>
            ))}
        </div>
        <p class="faded">
            {note.lines[1]} <span class="link">[[meetings/2026-10-20-kickoff#Open questions]]</span>
        </p>
        <p class="faded embed">![[launch-timeline.excalidraw.svg]]</p>
        <ul class="faded">
            <li>
                <span class="box"></span> Ship the release notes <span class="field">📅 2026-10-23</span>
            </li>
            <li>
                <span class="box"></span> Confirm the venue <span class="field">[due:: 2026-10-30]</span>
            </li>
        </ul>
    </div>
</div>

<style>
    .editor {
        min-height: 25rem;
    }
    .tab {
        padding: 0.15rem 0.6rem;
        border-radius: var(--radius-s);
        background: var(--fill);
        color: var(--text);
    }
    .tab.muted {
        background: none;
        color: var(--text-secondary);
    }
    .doc {
        position: relative;
        padding: 1.4rem 1.75rem 1.75rem;
        font-size: 15px;
    }
    .props {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 0.75rem;
        color: var(--text-secondary);
        font-size: 12px;
    }
    .status {
        background: color-mix(in srgb, var(--warning) 16%, transparent);
        color: var(--warning);
    }
    .tag {
        background: color-mix(in srgb, var(--accent) 14%, transparent);
        color: var(--accent);
    }
    h3 {
        margin: 0 0 0.75rem;
        font-size: 1.6rem;
        letter-spacing: -0.02em;
    }
    p {
        margin: 0 0 0.6rem;
    }
    .typed {
        display: inline-block;
        overflow: hidden;
        vertical-align: bottom;
        white-space: nowrap;
        color: var(--accent);
        width: 0;
    }
    .caret {
        display: inline-block;
        width: 1.5px;
        height: 1.1em;
        margin-left: 1px;
        vertical-align: text-bottom;
        background: var(--accent);
    }
    .is-playing .caret {
        animation: blink 1s steps(1) infinite;
    }
    .picker {
        position: absolute;
        left: 3.5rem;
        top: 7.6rem;
        z-index: 1;
        width: min(20rem, 80%);
        padding: 0.3rem;
        border-radius: var(--radius-l);
        background: var(--card);
        box-shadow:
            0 12px 32px rgba(0, 0, 0, 0.16),
            0 0 0 1px var(--separator);
        opacity: 0;
        transform: translateY(-4px) scale(0.98);
    }
    .option {
        padding: 0.35rem 0.6rem;
        border-radius: var(--radius-s);
        font-size: 13px;
    }
    .option.first {
        background: var(--accent-soft);
    }
    .path {
        font-family: var(--font-mono);
        font-size: 12px;
    }
    .faded {
        color: var(--text-secondary);
    }
    .link {
        color: var(--accent);
    }
    .embed {
        font-family: var(--font-mono);
        font-size: 12.5px;
    }
    ul {
        margin: 0.5rem 0 0;
        padding: 0;
        list-style: none;
    }
    li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-height: 1.75rem;
    }
    .box {
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--text-tertiary);
        border-radius: 4px;
    }
    .field {
        color: var(--text-tertiary);
        font-size: 12.5px;
    }

    .is-playing .typed {
        animation: type 7s steps(13) infinite;
    }
    .is-playing .picker {
        animation: picker 7s var(--ease-out) infinite;
    }
    @keyframes type {
        0%,
        12% {
            width: 0;
        }
        40%,
        100% {
            width: 13ch;
        }
    }
    @keyframes picker {
        0%,
        14% {
            opacity: 0;
            transform: translateY(-4px) scale(0.98);
        }
        20%,
        80% {
            opacity: 1;
            transform: none;
        }
        88%,
        100% {
            opacity: 0;
            transform: translateY(-4px) scale(0.98);
        }
    }
    @keyframes blink {
        50% {
            opacity: 0;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .typed {
            width: 13ch;
        }
        .picker {
            opacity: 1;
            transform: none;
        }
    }
</style>
