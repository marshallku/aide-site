---
// The Feed: events from plugins flow into one log and land in the bucket triage gives them.
import { COPY, type Lang } from "#lib/landing-copy";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = COPY[lang];
const BUCKET_Y = { action: 70, need: 180, interest: 290 } as const;
const sources = copy.feedItems.map((item, index) => ({
    ...item,
    name: item.meta.split(" · ")[0],
    y: 30 + index * 60,
}));
const buckets = (["action", "need", "interest"] as const).map((bucket) => ({
    bucket,
    label: copy.buckets[bucket],
    items: copy.feedItems.filter((item) => item.bucket === bucket),
}));
const path = (y: number, bucket: keyof typeof BUCKET_Y) =>
    `M 132 ${y} C 250 ${y}, 260 ${BUCKET_Y[bucket]}, 372 ${BUCKET_Y[bucket]}`;
---

<div class="feed" data-play aria-hidden="true">
    <svg class="wires" viewBox="0 0 600 360" preserveAspectRatio="none">
        {sources.map((source, index) => (
            <g class:list={["wire", source.bucket]} style={`--i: ${index}`}>
                <path class="track" d={path(source.y, source.bucket as keyof typeof BUCKET_Y)} />
                <path class="pulse" d={path(source.y, source.bucket as keyof typeof BUCKET_Y)} pathLength="100" />
            </g>
        ))}
    </svg>
    <ul class="sources">
        {sources.map((source) => (
            <li style={`top: ${(source.y / 360) * 100}%`}>
                <span class:list={["dot", source.bucket]} />
                {source.name}
            </li>
        ))}
    </ul>
    <div class="buckets">
        {buckets.map((bucket, index) => (
            <div class:list={["bucket", bucket.bucket]} style={`--i: ${index}`}>
                <p class="label">
                    {bucket.label}
                    <span class="count">{bucket.items.length}</span>
                </p>
                {bucket.items.map((item) => (
                    <p class="item">{item.title}</p>
                ))}
            </div>
        ))}
    </div>
</div>

<style>
    .feed {
        position: relative;
        aspect-ratio: 5 / 3;
        font-size: 13px;
    }
    .wires {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }
    .track,
    .pulse {
        fill: none;
        vector-effect: non-scaling-stroke;
    }
    .track {
        stroke: var(--line-strong);
        stroke-width: 1;
    }
    .pulse {
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-dasharray: 6 100;
        stroke-dashoffset: 6;
        opacity: 0;
    }
    .action .pulse {
        stroke: var(--danger);
    }
    .need .pulse {
        stroke: var(--accent);
    }
    .interest .pulse {
        stroke: var(--brand-2);
    }
    .is-playing .pulse {
        animation: flow 3.6s var(--ease-out) infinite;
        animation-delay: calc(var(--i) * 0.6s);
    }
    @keyframes flow {
        0% {
            stroke-dashoffset: 6;
            opacity: 0;
        }
        8% {
            opacity: 1;
        }
        70% {
            stroke-dashoffset: -100;
            opacity: 1;
        }
        71%,
        100% {
            stroke-dashoffset: -100;
            opacity: 0;
        }
    }
    .sources {
        position: absolute;
        inset: 0 auto 0 0;
        width: 22%;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .sources li {
        position: absolute;
        right: 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        background: var(--page-raised);
        box-shadow: 0 0 0 1px var(--line);
        font-family: var(--font-mono);
        font-size: 12px;
        transform: translateY(-50%);
    }
    .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }
    .dot.action {
        background: var(--danger);
    }
    .dot.need {
        background: var(--accent);
    }
    .dot.interest {
        background: var(--brand-2);
    }
    .buckets {
        position: absolute;
        inset: 0 0 0 62%;
        display: grid;
        grid-template-rows: repeat(3, 1fr);
        gap: 0.6rem;
    }
    .bucket {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0.6rem 0.85rem;
        border-radius: 14px;
        background: var(--card);
        box-shadow:
            0 6px 20px -8px rgba(0, 0, 0, 0.15),
            0 0 0 1px var(--line);
        overflow: hidden;
    }
    .label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 0 0.3rem;
        font-weight: 650;
    }
    .action .label {
        color: var(--danger);
    }
    .count {
        min-width: 1.4rem;
        padding: 0 0.4rem;
        border-radius: 999px;
        background: var(--fill);
        color: var(--text-secondary);
        font-size: 11px;
        text-align: center;
    }
    .item {
        margin: 0;
        overflow: hidden;
        color: var(--text-secondary);
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    @media (max-width: 560px) {
        .feed {
            aspect-ratio: 4 / 3.4;
        }
        .sources li {
            font-size: 10.5px;
            padding: 0.2rem 0.45rem;
        }
        .buckets {
            inset: 0 0 0 56%;
        }
        .item {
            display: none;
        }
    }
</style>
