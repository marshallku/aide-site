---
// AIDE's desktop character (Mochi or Piyo) as a canvas, with an optional speech bubble. `scene`
// "assistant" plays the assistant at work: it thinks, then has something to say (the bubble).
interface Props {
    id?: "mochi" | "piyo";
    size?: number;
    bubble?: string;
    scene?: "idle" | "assistant";
    accent?: string;
    class?: string;
}

const { id = "mochi", size = 120, bubble, scene = "idle", accent = "#5856d6", class: className } = Astro.props;
---

<div class:list={["character", className]} data-character={id} data-scene={scene} data-accent={accent}>
    {bubble && <p class="bubble">{bubble}</p>}
    <canvas width={size} height={size} style={`width: ${size}px; height: ${size}px`} aria-hidden="true"></canvas>
</div>

<script>
    import { mountCharacter } from "#scripts/character";

    for (const root of document.querySelectorAll<HTMLElement>("[data-character]")) {
        const canvas = root.querySelector("canvas");
        if (!canvas) continue;
        const character = mountCharacter(canvas, {
            id: root.dataset.character === "piyo" ? "piyo" : "mochi",
            accent: root.dataset.accent ?? "#5856d6",
        });
        canvas.addEventListener("pointerenter", () => character.poke(), { passive: true });
        canvas.addEventListener("click", () => character.poke(), { passive: true });
        if (root.dataset.scene !== "assistant") continue;

        // Thinks for a while, then has something to say; again every so often, while on screen.
        // Under Reduce Motion it just has something to say.
        const reduce = matchMedia("(prefers-reduced-motion: reduce)");
        let saying = false;
        let timer = 0;
        const show = (next: boolean) => {
            saying = next;
            character.set({ busy: !saying, bubble: saying ? "radar" : null });
            root.classList.toggle("is-saying", saying);
        };
        const stop = () => {
            clearInterval(timer);
            timer = 0;
        };
        const run = (onScreen: boolean) => {
            stop();
            if (reduce.matches) return show(true);
            if (!onScreen) return;
            show(!saying);
            timer = window.setInterval(() => show(!saying), 4200);
        };
        let visible = false;
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            run(visible);
        }).observe(root);
        reduce.addEventListener("change", () => run(visible));
    }
</script>

<style>
    .character {
        position: relative;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
    }
    canvas {
        cursor: pointer;
        touch-action: manipulation;
    }
    .bubble {
        position: absolute;
        bottom: calc(100% - 0.75rem);
        left: 50%;
        width: max-content;
        max-width: 15rem;
        margin: 0;
        padding: 0.55rem 0.8rem;
        border-radius: 14px;
        background: var(--card);
        box-shadow:
            0 10px 30px -10px rgba(0, 0, 0, 0.3),
            0 0 0 1px var(--line);
        color: var(--text);
        font-size: 0.85rem;
        line-height: 1.4;
        opacity: 0;
        transform: translate(-50%, 6px) scale(0.96);
        transform-origin: 50% 100%;
        transition:
            opacity 0.35s var(--ease-out),
            transform 0.35s var(--ease-out);
    }
    .bubble::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        border: 7px solid transparent;
        border-top-color: var(--card);
        transform: translateX(-50%);
    }
    .character[data-scene="idle"] .bubble,
    .is-saying .bubble {
        opacity: 1;
        transform: translate(-50%, 0);
    }
</style>
