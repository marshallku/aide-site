---
// One of AIDE's icons (src/assets/aide/icons, synced from the app), inline so it takes currentColor.
interface Props {
    name: string;
    size?: number;
    class?: string;
}

const ICONS = import.meta.glob<string>("/src/assets/aide/icons/*.svg", {
    query: "?raw",
    import: "default",
    eager: true,
});
const { name, size = 20, class: className } = Astro.props;
const svg = ICONS[`/src/assets/aide/icons/${name}.svg`];
if (!svg) throw new Error(`no icon ${name}: add it to ICONS in scripts/sync-from-aide.mjs`);
const sized = svg.replace("<svg ", `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `);
---

<span class:list={["icon", className]} set:html={sized} />

<style>
    .icon {
        display: inline-flex;
        flex: none;
    }
</style>
