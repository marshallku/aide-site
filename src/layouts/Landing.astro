---
import "#styles/fonts.css";
import "#styles/tokens.css";

interface Props {
    title: string;
    description: string;
    lang: "en" | "ko";
}

const { title, description, lang } = Astro.props;
const alternate = lang === "en" ? "/ko/" : "/";
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL("/", Astro.site)} />
        <link rel="alternate" hreflang="ko" href={new URL("/ko/", Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
        <link rel="alternate" hreflang={lang === "en" ? "ko" : "en"} href={alternate} />
    </head>
    <body>
        <slot />
    </body>
</html>

<style is:global>
    body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--card);
        color: var(--text);
    }
</style>
